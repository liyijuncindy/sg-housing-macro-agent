# Copy this file to .env in the same folder and fill values locally.
# Never paste the key in chat or commit .env.
LLM_PROVIDER=soclaas
SOCLAAS_API_KEY=
# Pin the service model ID instead of its mutable default alias.
SOCLAAS_MODEL=qwen3.6:35b
# OpenAI is an alternative; select it explicitly with --provider openai.
OPENAI_API_KEY=
# Set a tool-capable model ID available to your API project.
OPENAI_MODEL=gpt-5.4
