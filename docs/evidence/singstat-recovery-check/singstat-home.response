bae4\"},{\"title\":\"What is Shrinkflation?\",\"url_type\":\"file\",\"url\":{\"type\":\"internal\",\"url\":\"\",\"internal_id\":\"eb93972c-f560-4c57-a128-51ccf97b84ea\",\"internal_label\":\"What is Shrinkflation?\",\"fieldType\":\"InputLink\",\"collection_source\":\"xtr_cms_pages\"},\"file\":\"61144ec7-2081-4da1-91ae-56a5ccb36ea5\",\"description\":\"An explanation of hidden price increases with examples of products most affected by shrinkflation.\",\"image\":\"0c3e8430-87c7-4d01-a3d1-eeb068a5892f\"},{\"title\":\"Growing Beyond Borders\",\"url\":{\"type\":\"internal\",\"url\":\"\",\"internal_label\":\"How does internationalisation contribution to Singapore Infographic\",\"fieldType\":\"InputLink\",\"collection_source\":\"xtr_cms_pages\"},\"description\":\"How does internationalisation contribute to Singapore?\",\"image\":\"391a460d-d409-4d61-b2a0-aee0cc731d2e\",\"url_type\":\"file\",\"file\":\"f6616ac6-ce6b-468b-ac93-3c026e5c5dea\"},{\"title\":\"The Role of Trade in Economic Growth\",\"url_type\":\"file\",\"url\":{\"type\":\"internal\",\"url\":\"\",\"internal_id\":\"ddeea678-ac07-402f-8d16-a4472854352e\",\"internal_label\":\"How does Trade Contribute to Output-based GDP?\",\"fieldType\":\"InputLink\",\"collection_source\":\"xtr_cms_pages\"},\"file\":\"23278488-7b33-4c23-a4fe-a9f78f00d413\",\"description\":\"Find out how trade plays a vital role in shaping Singapore’s economic landscape.\",\"image\":\"82efd65d-81a6-40c6-8479-66955b3f88cc\"},{\"title\":\"Changes to the Key Household Income Trends 2025\",\"url\":{\"type\":\"internal\",\"url\":\"\",\"internal_label\":\"How Does Hosting Formula (F1) Benefit Singapore's Economy\",\"fieldType\":\"InputLink\",\"collection_source\":\"xtr_cms_pages\"},\"description\":\"Find out more about the changes to the income and household coverage in the Key Household Income Trends report.\",\"image\":\"aa33730e-d2e5-4659-9b5c-b69fc704d3ba\",\"url_type\":\"file\",\"file\":\"c2cc2968-0601-4fb1-be16-735e710e6666\"},{\"title\":\"Household S